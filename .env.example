# KynangCK AI Studio — Biến môi trường
# Copy file này thành .env và điền giá trị thực

# Supabase (lấy từ Dashboard > Project Settings > API)
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGci...

# Admin authentication (mật khẩu đăng nhập quản trị)
ADMIN_PASSWORD=kynangck-admin

# Gemini AI (tùy chọn — dùng cho AI generate nội dung)
GEMINI_API_KEY=

# Google Drive (tùy chọn — dùng cho media library)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Dev server
DISABLE_HMR=false
